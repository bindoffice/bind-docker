DOCKER_REGISTRY="registry.cn-shanghai.aliyuncs.com/" #  如果访问docker hub比较慢，可以改成使用阿里云容器服务 "registry.cn-shanghai.aliyuncs.com/"
DOMAIN="work.example.com"  # 域名
ADMIN_EMAIL="xxx@example.com"
ADMIN_PASSWORD="passwordneedchange"
BINDIP=127.0.0.1
MINIO_USER="changeusername"
MINIO_PASSWORD="changepassword"
MINIO_ADDR="127.0.0.1:9000"
MINIO_USESSL="false"
MINIO_WEB_ADDR="127.0.0.1:9001"
DRIVE_BUCKET="drive"
MAIL_BUCKET="mails"
PUBLIC_DRIVE_PREFIX=""
LICENSE=""
# PostgreSQL
# POSTGRES_ADDR 既是客户端连接地址，也是端口发布地址：
# POSTGRES_ADDR is both the client address and the published address:
#   "127.0.0.1:5432" 仅宿主机本机可访问 / host loopback only
#   "0.0.0.0:5432"   对局域网开放 / exposed on the LAN
POSTGRES_IMAGE="postgres:16"
POSTGRES_ADDR="127.0.0.1:5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changepassword"
POSTGRES_EXTENSIONS=""
DB_NAME="bind_selfhost"
OFFICE_API_ADDR="127.0.0.1:42201"
# Redis
# REDIS_ADDR 与 POSTGRES_ADDR 同理，既是客户端连接地址也是端口发布地址；
# REDIS_ADDR works the same way as POSTGRES_ADDR (client address and published address);
# redis 无密码，不要设成 0.0.0.0 / redis has no password, do not use 0.0.0.0
REDIS_ADDR="127.0.0.1:6379"
REDIS_USER=""
REDIS_PASSWORD=""
CERT_DIR="/tmp/bind_certs"
IMAP_ADDR="127.0.0.1:42994"
IMAP_TLS_ADDR="127.0.0.1:42993"
SEARCH_ADDR="127.0.0.1:41701"
LOCAL_SMTP_DOMAIN="work.example.com"
NATS_URL="nats://127.0.0.1:42422"
NATS_CLUSTER_ID=""
ALLOW_ORIGIN="http://127.0.0.1:4200"
SMTP_ADDR="127.0.0.1:42025"
SMTP_TLS_ADDR="127.0.0.1:42465"
MEET_SERVER="/"
MEET_KEY="changekeyandsecret"
MEET_SECRET="c7056e2x9689f7f3ecx8c6e4055c4bc565dc9c5a"
MEET_ADDR="127.0.0.1:8888"
MEET_AUTH_TYPE=""
MQTT_ID="1"
TASK_MQTT_ID="bind-task"
MQTT_IP="127.0.0.1" 
MQTT_PORT="1883"
MQTT_PROTOCOL="wss" 
MQTT_PUBLIC_PORT="41883"
AI_TOKEN=""
AI_MODEL=""
AI_TYPE="deepseek"
TYPESENSE_ADDR="127.0.0.1"
TYPESENSE_PORT="48108"
TYPESENSE_KEY="a31a010f7199530c1a16b83b7168ea40"
RSPAMD_SERVER=""
RSPAMD_PASSWORD=""
MCP_ADDR="127.0.0.1:42705"
TASK_SECRET="task_secret_need_change"
CERT_RENEW_DAYS="30" # 证书剩余天数少于该值时自动续期 / auto-renew when fewer days than this remain
CERT_CRON_SCHEDULE="0 3 * * *" # `make cron` 安装的 crontab 计划 / crontab schedule installed by `make cron`
